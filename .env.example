# ========= LLM =========
# Provider: self-hosted | gemini | mock
PROVIDER=self-hosted

# Coforge Quasar (OpenAI-compatible chat completions)
LLM_API_KEY=your-quasar-key
MODEL=gpt-5.2
LLM_API_URL=https://quasarmarket.coforge.com/qag/llmrouter-api/v2/chat/completions

# Alternate Quasar model:
# MODEL=gemini-2.5-flash
# LLM_API_KEY=your-gemini-router-key

# Optional: Google AI Studio direct (PROVIDER=gemini)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

LLM_FALLBACK_ENABLED=true
MAX_TOKENS=4000
QUERY_TIMEOUT=300
DEV_BEARER_TOKEN=dev-token-123
APP_PORT=8000

# Offline demo:
# PROVIDER=mock
